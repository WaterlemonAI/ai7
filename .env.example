# Site environment
NEXT_PUBLIC_DEPLOY_ENV=development

# AWS DynamoDB data layer. Use the CloudFormation stack outputs for table names.
AWS_REGION=me-central-1
AWS_DYNAMODB_SUBSCRIBERS_TABLE=
AWS_DYNAMODB_BOOKINGS_TABLE=

# AI7Lab scheduling — SMTP credentials are supplied at deployment time.
SCHEDULER_SMTP_HOST=
SCHEDULER_SMTP_PORT=587
SCHEDULER_SMTP_SECURE=false
SCHEDULER_SMTP_USER=
SCHEDULER_SMTP_PASS=
SCHEDULER_SMTP_FROM="AI7Lab <meetings@ai7lab.net>"
SCHEDULER_ORGANIZER_EMAIL=

# Audience routing. Product enquiries can go to different inboxes;
# the default receives general business-problem conversations.
SCHEDULER_RECIPIENT_DEFAULT=
SCHEDULER_RECIPIENT_VENDOREYE=
SCHEDULER_RECIPIENT_ROLEFIELD=
SCHEDULER_RECIPIENT_ENTERPRISE=
SCHEDULER_RECIPIENT_PARTNERSHIP=
